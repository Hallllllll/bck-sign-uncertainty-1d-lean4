import NextProof.DualSound

/-! Positive quadrature control on the 17 distinct nodes in dual/quadrature_16_17.json.
The first nine exact modes exclude every admissible even Laguerre sum through degree 16. -/
namespace NextProof.Dual

def controlRule16 : Rule := [
  (1912, Int.ofNat (nat_lit )),
  (3263, Int.ofNat (nat_lit )),
  (5268, Int.ofNat (nat_lit )),
  (7756, Int.ofNat (nat_lit )),
  (27039, Int.ofNat (nat_lit )),
  (27548, Int.ofNat (nat_lit )),
  (32926, Int.ofNat (nat_lit )),
  (33875, Int.ofNat (nat_lit )),
  (40016, Int.ofNat (nat_lit )),
  (42311, Int.ofNat (nat_lit )),
  (47553, Int.ofNat (nat_lit )),
  (54797, Int.ofNat (nat_lit )),
  (63047, Int.ofNat (nat_lit )),
  (70791, Int.ofNat (nat_lit )),
  (89451, Int.ofNat (nat_lit )),
  (90381, Int.ofNat (nat_lit )),
  (117610, Int.ofNat (nat_lit ))]

theorem checksControl16 : check 1000 controlRule16 9 = true := by decide +kernel

theorem degree16_control (a : ℕ → ℝ) (horigin : (evenPolynomial 8 a).eval 0 ≤ 0)
    (htail : ∀ t : ℝ, 191/100 ≤ t → 0 ≤ (evenPolynomial 8 a).eval t) :
    evenPolynomial 8 a = 0 := by
  have hb : controlRule16.all (fun u => decide (1910 < u.1 ∧ 0 < u.2)) = true := by decide +kernel
  have hb' : ∀ u ∈ controlRule16, 1910 < u.1 ∧ 0 < u.2 := by
    simpa only [List.all_eq_true, decide_eq_true_eq] using hb
  apply eq_zero_of_moments 1000 controlRule16 8 (191/100) (by decide) (by decide +kernel)
    (fun u hu => (hb' u hu).2) _ (by decide +kernel)
    (fun k hk => check_sound checksControl16 k (by omega)) a horigin htail
  intro u hu
  have h : (1910 : ℝ) < u.1 := by exact_mod_cast (hb' u hu).1
  norm_num
  linarith

end NextProof.Dual

#print axioms NextProof.Dual.degree16_control
